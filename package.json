{
  "name": "waterfall",
  "version": "0.1.0",
  "description": "OpenTUI raw binary waterfall player.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.14",
  "bin": {
    "waterfall": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "check": "bun run tsc --noEmit",
    "build": "rm -rf ./dist && bun build ./src/index.ts --target=bun --outdir ./dist --entry-naming waterfall.[ext] --asset-naming [name].[ext]",
    "build:standalone": "bun build ./src/index.ts --compile --outfile ./waterfall"
  },
  "dependencies": {
    "@opentui/core": "^0.2.16"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "typescript": "^5.9.3"
  }
}
